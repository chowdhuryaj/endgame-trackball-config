#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>
#include <input/processors/twist_router.dtsi>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

/ {
	behaviors {
		// AJ: one tap = leave dongle (BLE profile 0, USB when plugged in), double tap = dongle
		usb_or_dgl: usb-or-dongle {
			compatible = "zmk,behavior-tap-dance";
			display-name = "Leave dongle (click) or switch to dongle (double-click)";
			#binding-cells = <0>;
			bindings = <&bt BT_SEL 0>, <&goto_esb>;
			tapping-term-ms = <400>;
		};

		// AJ: top-left button, tap = Studio Unlock (was Enter), hold = Snipe layer.
		// Switches keep dying; this keeps an unlock key on the base layer.
		ltsu: layer-tap-studio-unlock {
			compatible = "zmk,behavior-hold-tap";
			display-name = "Hold: layer, tap: Studio Unlock";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&studio_unlock>;
			hold-while-undecided;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			DECLARE_ENCODERS;
			bindings = <
			    // buttons
			    &ltsu LAYER_SNIPE 0       &ltmkp LAYER_SCROLL ESC
			    &mkp MCLK                 &cdch LAYER_SCROLL 0
			    &mkp LCLK                 &mkp RCLK
			    &ltm LAYER_EXTRAS MB4     &ltm LAYER_DEVICE MB5

			    // rotary encoders
			    &kp C_VOL_UP              &kp LC(TAB)
			    &kp C_VOL_DN              &kp LC(LS(TAB))
		    >;
		};

		layer1 {
			display-name = "Extras";
			DECLARE_ENCODERS;
			bindings = <
			    &bst_copy      &bst_paste
			    &bst_cut       &bst_undo
			    &usb_or_dgl    &studio_unlock  // AJ: MB5 dead, so Device-layer keys live here (hold MB4)
			    &trans         &bst_paste

			    &kp C_VOL_UP   &kp LC(TAB)
			    &kp C_VOL_DN   &kp LC(LS(TAB))
	   		>;
		};

		layer2 {
			display-name = "Device";
			DECLARE_ENCODERS;
			bindings = <
			    &mui_or_dgl          &bt BT_CLR
			    &bst_tog ZBS_TOG     &bt BT_NXT
			    &af_toggle AF_TOG    &bt BT_PRV
			    &studio_unlock       &trans

			    &kp C_VOL_UP         &kp LC(TAB)
			    &kp C_VOL_DN         &kp LC(LS(TAB))
		   	>;
		};

		layer3 {
			display-name = "Scroll";
			DECLARE_ENCODERS;
			bindings = <
			    &trans              &trans
			    &trans              &scrlsens P2SM_INC 1
			    &rrl 1              &scrlsens P2SM_DEC 1
			    &sens P2SM_DEC 1    &sens P2SM_INC 1

			    &sens P2SM_DEC 1    &scrlsens P2SM_INC 1
			    &sens P2SM_INC 1    &scrlsens P2SM_DEC 1
		  	>;
		};

		layer4 {
			display-name = "Snipe";
			DECLARE_ENCODERS;
			bindings = <
			    &trans           &soft_off
			    &trans           &trans
			    &trans           &trans
			    &trans           &trans

			    &kp LEFT         &kp RIGHT
			    &kp RIGHT        &kp LEFT
	   		>;
		};

		layer5 {
			display-name = "User";
			DECLARE_ENCODERS;
			bindings = <
				&trans        &trans
				&trans        &trans
				&trans        &trans
				&trans        &trans

				&kp C_VOL_UP  &kp LC(TAB)
				&kp C_VOL_DN  &kp LC(LS(TAB))
		    >;
		};
	};

	trackball {
		// AJ: twist/cursor routers = runtime rules (shell: twist rule / cursor rule); no rules = pass-through
		input-processors = <&zip_bistable_twist_scaler>, <&zip_twist_router>, <&zip_cursor_router>,
						   <&zip_pointer_accel>, <&zip_scroll_accel>, <&zip_rotate_pointer>,
		                   <&esb_ip>, <&zip_ble_report_rate_limit>;

		scroll {
			layers = <LAYER_SCROLL>;
			input-processors = <&zip_twist_router>, <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
							   <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
							   <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};

		snipe {
			layers = <LAYER_SNIPE>;
			input-processors = <&zip_twist_router>, <&zip_cursor_router>, <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
							   <&esb_ip>, <&zip_ble_report_rate_limit>;
		};
	};
};
